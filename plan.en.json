    "approachSkill": {
      "title": "The approach jump is the single most valuable drill for adding vertical",
      "description": "Rhythm is \"small – big – together\": a small first step, one fast max-speed stride, then quickly close the feet together into the takeoff. On the last two steps, let the heel touch down briefly and lean the body slightly back to convert horizontal speed into upward force. Swing the arms back hard, then drive them up. Mark a wall and check your reach every 2-3 weeks — get the mechanics right and the height follows on its own."
    },
    "specialMoves": [
      {
        "name": "Squat Jump",
        "tag": "Power + Coordination",
        "tone": "blue",
        "description": "Bodyweight or light load, absorb on landing immediately, no continuous bouncing (reset each rep)."
      },
      {
        "name": "Volleyball Block Footwork",
        "tag": "Lateral Shuffle",
        "tone": "blue",
        "description": "Lateral shuffle into a vertical jump — trains footwork transition efficiency, not just jump height."
      },
      {
        "name": "Landing Stability Drill",
        "tag": "Safety First",
        "tone": "amber",
        "description": "Land light after each jump, knees tracking toes, absorb like sitting into a chair — this matters more than how high you jump."
      }
    ],
    "phaseNote": {
      "title": "How to think about explosiveness during the cut?",
      "description": "The Aug-Oct deficit is bigger, so this phase prioritizes movement quality and neural coordination — don't chase record weights or heights. Real gains in strength and jump usually show up once you shift to maintenance in Nov-Dec, when energy availability is higher."
    }
